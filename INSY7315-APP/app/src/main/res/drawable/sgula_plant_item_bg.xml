<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sgula_danger_soft" />
            <corners android:radius="@dimen/sgula_radius_md" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sgula_plum_100" />
            <corners android:radius="@dimen/sgula_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sgula_surface_sunken" />
            <corners android:radius="@dimen/sgula_radius_md" />
        </shape>
    </item>
</selector>
