<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="@dimen/sgula_growbar_height" />
            <solid android:color="@color/sgula_warm_gray_100" />
            <corners android:radius="@dimen/sgula_growbar_radius" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="@dimen/sgula_growbar_height" />
                <solid android:color="@color/sgula_plum_500" />
                <corners android:radius="@dimen/sgula_growbar_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
