<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Sgula" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/sgula_text</item>
    </style>

    <style name="TextAppearance.Sgula.H1">
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:textSize">@dimen/sgula_font_xxl</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="TextAppearance.Sgula.H2">
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:textSize">@dimen/sgula_font_xl</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="TextAppearance.Sgula.H3">
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:textSize">@dimen/sgula_font_lg</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="TextAppearance.Sgula.Body">
        <item name="android:textSize">@dimen/sgula_font_base</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="TextAppearance.Sgula.BodySecondary" parent="TextAppearance.Sgula.Body">
        <item name="android:textColor">@color/sgula_text_secondary</item>
    </style>

    <style name="TextAppearance.Sgula.BodySmall">
        <item name="android:textSize">@dimen/sgula_font_sm</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="TextAppearance.Sgula.Caption">
        <item name="android:textSize">@dimen/sgula_font_xs</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/sgula_text_tertiary</item>
    </style>

    <style name="TextAppearance.Sgula.Label">
        <item name="android:textSize">@dimen/sgula_font_sm</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Sgula.Button">
        <item name="android:textSize">@dimen/sgula_font_base</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Sgula.ButtonSmall" parent="TextAppearance.Sgula.Button">
        <item name="android:textSize">@dimen/sgula_font_sm</item>
    </style>

    <style name="TextAppearance.Sgula.Eyebrow">
        <item name="android:textSize">@dimen/sgula_font_xs</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/sgula_plum_600</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Sgula.Affirmation">
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:textSize">@dimen/sgula_font_xl</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/sgula_plum_900</item>
    </style>

    <style name="TextAppearance.Sgula.RingValue">
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:textSize">@dimen/sgula_font_xxl</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/sgula_plum_800</item>
    </style>

    <style name="TextAppearance.Sgula.Link" parent="TextAppearance.Sgula.Body">
        <item name="android:textColor">@color/sgula_plum_700</item>
    </style>

    <style name="TextAppearance.Sgula.TableHeader" parent="TextAppearance.Sgula.Caption">
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Sgula.FieldHint" parent="TextAppearance.Sgula.BodySmall">
        <item name="android:textColor">@color/sgula_text_tertiary</item>
    </style>

    <style name="TextAppearance.Sgula.FieldError" parent="TextAppearance.Sgula.BodySmall">
        <item name="android:textColor">@color/sgula_danger_hover</item>
        <item name="android:textFontWeight">600</item>
