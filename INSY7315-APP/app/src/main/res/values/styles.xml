<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Sgula.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.Button</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/sgula_button_min_height</item>
        <item name="android:paddingLeft">@dimen/sgula_button_h_padding</item>
        <item name="android:paddingRight">@dimen/sgula_button_h_padding</item>
        <item name="android:paddingTop">@dimen/sgula_button_v_padding</item>
        <item name="android:paddingBottom">@dimen/sgula_button_v_padding</item>

        <item name="cornerRadius">@dimen/sgula_radius_md</item>
        <item name="rippleColor">@color/sgula_transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/sgula_button_press</item>

        <item name="iconPadding">@dimen/sgula_space_2</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Sgula.Button.Primary">
        <item name="backgroundTint">@color/sgula_button_primary_bg</item>
        <item name="android:textColor">@color/sgula_button_on_primary</item>
        <item name="iconTint">@color/sgula_button_on_primary</item>
    </style>

    <style name="Widget.Sgula.Button.Secondary">
        <item name="backgroundTint">@color/sgula_button_secondary_bg</item>
        <item name="android:textColor">@color/sgula_button_secondary_fg</item>
        <item name="iconTint">@color/sgula_button_secondary_fg</item>
        <item name="strokeWidth">@dimen/sgula_field_border</item>
        <item name="strokeColor">@color/sgula_button_secondary_stroke</item>
    </style>

    <style name="Widget.Sgula.Button.Ghost">
        <item name="backgroundTint">@color/sgula_button_ghost_bg</item>
        <item name="android:textColor">@color/sgula_button_ghost_fg</item>
        <item name="iconTint">@color/sgula_button_ghost_fg</item>
    </style>

    <style name="Widget.Sgula.Button.Destructive">
        <item name="backgroundTint">@color/sgula_button_destructive_bg</item>
        <item name="android:textColor">@color/sgula_button_on_primary</item>
        <item name="iconTint">@color/sgula_button_on_primary</item>
    </style>

    <style name="Widget.Sgula.Button.Primary.Small">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.ButtonSmall</item>
        <item name="android:minHeight">@dimen/sgula_button_small_min_height</item>
        <item name="android:paddingLeft">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingRight">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingTop">@dimen/sgula_button_small_v_padding</item>
        <item name="android:paddingBottom">@dimen/sgula_button_small_v_padding</item>
    </style>

    <style name="Widget.Sgula.Button.Secondary.Small">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.ButtonSmall</item>
        <item name="android:minHeight">@dimen/sgula_button_small_min_height</item>
        <item name="android:paddingLeft">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingRight">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingTop">@dimen/sgula_button_small_v_padding</item>
        <item name="android:paddingBottom">@dimen/sgula_button_small_v_padding</item>
    </style>

    <style name="Widget.Sgula.Button.Ghost.Small">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.ButtonSmall</item>
        <item name="android:minHeight">@dimen/sgula_button_small_min_height</item>
        <item name="android:paddingLeft">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingRight">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingTop">@dimen/sgula_button_small_v_padding</item>
        <item name="android:paddingBottom">@dimen/sgula_button_small_v_padding</item>
    </style>

    <style name="Widget.Sgula.Button.Destructive.Small">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.ButtonSmall</item>
        <item name="android:minHeight">@dimen/sgula_button_small_min_height</item>
        <item name="android:paddingLeft">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingRight">@dimen/sgula_button_small_h_padding</item>
        <item name="android:paddingTop">@dimen/sgula_button_small_v_padding</item>
        <item name="android:paddingBottom">@dimen/sgula_button_small_v_padding</item>
    </style>


    <style name="Widget.Sgula.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/sgula_surface</item>
        <item name="cardCornerRadius">@dimen/sgula_radius_lg</item>
        <item name="cardElevation">@dimen/sgula_elevation_sm</item>
        <item name="contentPadding">@dimen/sgula_space_5</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="android:outlineAmbientShadowColor">@color/sgula_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/sgula_shadow</item>
    </style>

    <style name="Widget.Sgula.Card.Raised">
        <item name="cardElevation">@dimen/sgula_elevation_md</item>
    </style>

    <style name="Widget.Sgula.Text.CardTitle" parent="Widget.Sgula.Text.H3">
        <item name="android:layout_marginBottom">@dimen/sgula_space_2</item>
    </style>

    <style name="Widget.Sgula.Text.CardBody" parent="Widget.Sgula.Text.BodySecondary" />

    <style name="Widget.Sgula.Text.PageTitle" parent="Widget.Sgula.Text.H1" />

    <style name="Widget.Sgula.Text.PageSubtitle" parent="Widget.Sgula.Text.BodySecondary">
        <item name="android:layout_marginTop">@dimen/sgula_space_1</item>
    </style>


    <style name="Widget.Sgula.PointsToast" parent="Widget.Sgula.Text.BodySmall">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.PointsToast</item>
        <item name="android:background">@drawable/sgula_chip_plum_800</item>
        <item name="android:drawableStart">@drawable/sgula_dot_10</item>
        <item name="android:drawableTint">@color/sgula_accent</item>
        <item name="android:drawablePadding">@dimen/sgula_space_2</item>
        <item name="android:paddingLeft">@dimen/sgula_space_4</item>
        <item name="android:paddingRight">@dimen/sgula_space_4</item>
        <item name="android:paddingTop">@dimen/sgula_space_2</item>
        <item name="android:paddingBottom">@dimen/sgula_space_2</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Sgula.StatusBadge" parent="Widget.Sgula.Text.Caption">
        <item name="android:drawableStart">@drawable/sgula_dot_7</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Sgula.StatusBadge.Active">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.BadgeActive</item>
        <item name="android:background">@drawable/sgula_badge_active</item>
        <item name="android:drawableTint">@color/sgula_plum_500</item>
    </style>

    <style name="Widget.Sgula.StatusBadge.Deactivated">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.BadgeDeactivated</item>
        <item name="android:background">@drawable/sgula_badge_deactivated</item>
        <item name="android:drawableTint">@color/sgula_warm_gray_400</item>
    </style>


    <style name="Widget.Sgula.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/sgula_seekbar_track</item>
        <item name="android:thumb">@drawable/sgula_seekbar_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:max">100</item>
    </style>

    <style name="Widget.Sgula.GrowBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/sgula_growbar_progress</item>
        <item name="android:minHeight">@dimen/sgula_growbar_height</item>
        <item name="android:maxHeight">@dimen/sgula_growbar_height</item>
        <item name="android:max">100</item>
    </style>

    <style name="Widget.Sgula.IconToggle" parent="">
        <item name="android:layout_width">@dimen/sgula_icon_toggle</item>
        <item name="android:layout_height">@dimen/sgula_icon_toggle</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Sgula.Card.Table">
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.Sgula.AdminTable.Header" parent="">
        <item name="android:background">@color/sgula_surface_sunken</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/sgula_space_4</item>
        <item name="android:paddingRight">@dimen/sgula_space_4</item>
        <item name="android:paddingTop">@dimen/sgula_space_3</item>
        <item name="android:paddingBottom">@dimen/sgula_space_3</item>
    </style>

    <style name="Widget.Sgula.AdminTable.Row" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/sgula_space_4</item>
    </style>

    <style name="Widget.Sgula.AdminTable.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/sgula_border</item>
    </style>

    <style name="Widget.Sgula.Text.SectionTitle" parent="Widget.Sgula.Text.H2" />

    <style name="Widget.Sgula.Text.PlantStageName">
        <item name="android:textAppearance">@style/TextAppearance.Sgula.PlantStageName</item>
        <item name="android:lineHeight">25sp</item>
    </style>

    <style name="Widget.Sgula.Text.SectionNote" parent="Widget.Sgula.Text.BodySmall">
        <item name="android:textColor">@color/sgula_text_secondary</item>
        <item name="android:layout_marginTop">@dimen/sgula_space_1</item>
        <item name="android:layout_marginBottom">@dimen/sgula_space_4</item>
    </style>
</resources>
