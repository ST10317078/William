<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now playing" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/player_recommendation_card"
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommended session" />

                <TextView
                    android:id="@+id/player_recommendation_subtitle"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your matched meditation is loaded and ready to play." />

                <TextView
                    android:id="@+id/player_category_label"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="Meditation category: Calm reset" />

                <TextView
                    android:id="@+id/player_broadcast_label"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_1"
                    android:text="Broadcast: David's soft breath broadcast" />

                <TextView
                    android:id="@+id/player_answer_label"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_1"
                    android:text="Matched from: Calm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.example.insy7315_wil_.ui.widget.SgulaTrackArtView
            android:id="@+id/player_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sgula_space_6"
            app:sgulaArtSize="@dimen/sgula_player_art" />

        <TextView
            android:id="@+id/player_track_title"
            style="@style/Widget.Sgula.Text.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:gravity="center_horizontal"
            android:text="Calm reset" />

        <TextView
            android:id="@+id/player_track_subtitle"
            style="@style/Widget.Sgula.Text.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_1"
            android:gravity="center_horizontal"
            android:text="Guided meditation" />

        <TextView
            android:id="@+id/player_points_toast"
            style="@style/Widget.Sgula.PointsToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:visibility="gone"
            tools:text="+20 points"
            tools:visibility="visible" />

        <com.example.insy7315_wil_.ui.widget.SgulaPlayerBarView
            android:id="@+id/player_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            app:sgulaTitle="Calm reset"
            app:sgulaSubtitle="Guided meditation"
            app:sgulaElapsed="0:00"
            app:sgulaTotal="12:00"
            app:sgulaProgress="0" />

        <com.example.insy7315_wil_.ui.widget.SgulaDropdownFieldView
            android:id="@+id/player_sleep_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            app:sgulaLabel="Sleep timer"
            app:sgulaEntries="@array/sgula_sleep_timer" />

        <TextView
            android:id="@+id/player_sleep_timer_note"
            style="@style/Widget.Sgula.Text.SectionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:text="Playback stops on its own when the timer runs out." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>