<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sgula_background"
    android:fitsSystemWindows="true"
    tools:ignore="InconsistentLayout">

    <androidx.fragment.app.FragmentContainerView
        android:id="@id/sgula_nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingLeft="@dimen/sgula_space_4"
        android:paddingRight="@dimen/sgula_space_4"
        app:defaultNavHost="true"
        app:layout_constraintWidth_max="@dimen/sgula_content_max"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sgula_tab_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <com.example.insy7315_wil_.ui.widget.SgulaTabBarView
        android:id="@id/sgula_tab_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/sgula_tab_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
