<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quiz_option"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:background="@drawable/sgula_quiz_option_bg"
    android:padding="@dimen/sgula_space_4"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/quiz_radio"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:duplicateParentState="true"
        android:background="@drawable/sgula_quiz_radio" />

    <TextView
        android:id="@+id/quiz_text"
        style="@style/Widget.Sgula.Text.QuizOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sgula_space_3"
        tools:text="I felt calm for most of the day." />
</LinearLayout>
