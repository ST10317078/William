<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your recommendation" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We matched a meditation category and track to your answers." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:id="@+id/quiz_result_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Sleep" />

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:id="@+id/quiz_result_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Slow wind-down sessions to help you rest." />

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:id="@+id/quiz_result_track"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    tools:text="Suggested track: Evening wind down" />

                <TextView
                    style="@style/Widget.Sgula.PointsToast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_4"
                    android:text="+15 points" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next step" />

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap below to open the player with your recommended track." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quiz_open_player_button"
                    style="@style/Widget.Sgula.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_4"
                    android:text="Open player" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
