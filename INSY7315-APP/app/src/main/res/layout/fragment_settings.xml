<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="@dimen/sgula_space_5" android:paddingBottom="@dimen/sgula_space_6" tools:ignore="HardcodedText">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/Widget.Sgula.Text.PageTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings and profile" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Sgula.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/settings_name" style="@style/Widget.Sgula.Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" /><TextView android:id="@+id/settings_email" style="@style/Widget.Sgula.Text.CardBody" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout></com.google.android.material.card.MaterialCardView>
        <TextView style="@style/Widget.Sgula.Text.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5" android:text="Privacy" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settings_anonymous_insights" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_3" android:checked="true" android:text="Share anonymous wellness insights" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settings_reminders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_2" android:checked="true" android:text="Enable daily reminders" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settings_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_2" android:checked="true" android:text="Show activity progress" />
        <TextView style="@style/Widget.Sgula.Text.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5" android:text="Streak history" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Sgula.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_3"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView style="@style/Widget.Sgula.Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current streak: 5 days" /><TextView style="@style/Widget.Sgula.Text.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Longest streak: 12 days&#10;This week: Mon ✓  Tue ✓  Wed ✓  Thu ✓  Fri ✓  Sat ○  Sun ○" /></LinearLayout></com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/settings_admin_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/Widget.Sgula.Text.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5" android:text="Practice administration" />
            <TextView style="@style/Widget.Sgula.Text.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_2" android:text="Journal entries stay private to the member who wrote them and are never shown here." />
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_admin_upload" style="@style/Widget.Sgula.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_3" android:text="Upload audio" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_admin_affirmations" style="@style/Widget.Sgula.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_2" android:text="Daily affirmations" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_admin_accounts" style="@style/Widget.Sgula.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_2" android:text="Manage client accounts" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_admin_engagement" style="@style/Widget.Sgula.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_2" android:text="View engagement" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_logout" style="@style/Widget.Sgula.Button.Destructive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5" android:text="Log out" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
