<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="@dimen/sgula_space_5" android:paddingBottom="@dimen/sgula_space_6" tools:ignore="HardcodedText">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/password_reset_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/Widget.Sgula.Text.PageTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset your password" />
            <TextView style="@style/Widget.Sgula.Text.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enter your email and we’ll send password-reset instructions." />
            <com.example.insy7315_wil_.ui.widget.SgulaTextFieldView android:id="@+id/password_reset_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5" app:sgulaLabel="Email" app:sgulaPlaceholder="you@example.com" />
            <TextView android:id="@+id/password_reset_error" style="@style/Widget.Sgula.Text.CardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_4" android:textColor="@color/sgula_danger" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/password_reset_send" style="@style/Widget.Sgula.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sgula_space_5" android:text="Send reset link" />
        </LinearLayout>
        <LinearLayout android:id="@+id/password_reset_confirmation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/Widget.Sgula.Text.PageTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check your inbox" />
            <TextView style="@style/Widget.Sgula.Text.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="If an account exists for this email, we’ve sent password-reset instructions." />
        </LinearLayout>
        <TextView android:id="@+id/password_reset_login" style="@style/Widget.Sgula.Text.CardBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/sgula_space_5" android:clickable="true" android:focusable="true" android:text="Back to login" android:textColor="@color/sgula_plum_600" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
