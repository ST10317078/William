<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/journal_history_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sgula_space_5"
        android:paddingEnd="@dimen/sgula_space_5"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Sgula.Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Past entries" />

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Journal history" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse the month, then open a past entry in read mode to revisit it. Only you can see these entries." />

        <!-- Month snapshot -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/journal_month_previous"
                        style="@style/Widget.Sgula.Button.Ghost.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Previous month"
                        android:text="‹" />

                    <TextView
                        android:id="@+id/journal_month_label"
                        style="@style/Widget.Sgula.Text.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        tools:text="September 2026" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/journal_month_next"
                        style="@style/Widget.Sgula.Button.Ghost.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Next month"
                        android:text="›" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_4"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/journal_stat_entries"
                            style="@style/Widget.Sgula.Text.H3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Widget.Sgula.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Entries this month" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/journal_stat_words"
                            style="@style/Widget.Sgula.Text.H3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Widget.Sgula.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Words captured" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/journal_stat_streak"
                            style="@style/Widget.Sgula.Text.H3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />

                        <TextView
                            style="@style/Widget.Sgula.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Longest streak" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Calendar: filled in code for the selected month -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card.Table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/sgula_space_5">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calendar" />

                <TextView
                    style="@style/Widget.Sgula.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_1"
                    android:text="Highlighted days have an entry. Tap one to read it." />

                <LinearLayout
                    android:id="@+id/journal_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Read mode: shows one full entry, read only -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/journal_read_card"
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/journal_read_date"
                        style="@style/Widget.Sgula.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Mon, 21 Sep 2026 · 08:40" />

                    <TextView
                        style="@style/Widget.Sgula.StatusBadge.Active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sgula_space_3"
                        android:text="Read mode" />
                </LinearLayout>

                <TextView
                    android:id="@+id/journal_read_prompt"
                    style="@style/Widget.Sgula.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    tools:text="Prompt: What made you feel calm today?" />

                <TextView
                    android:id="@+id/journal_read_content"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:textIsSelectable="true"
                    tools:text="A calmer afternoon followed a slower start." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/journal_read_close"
                    style="@style/Widget.Sgula.Button.Ghost.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:text="Close" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Sgula.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:text="Past entries" />

        <TextView
            android:id="@+id/journal_list_note"
            style="@style/Widget.Sgula.Text.SectionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap an entry to open it in read mode." />

        <!-- Loading / empty / error states -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/journal_history_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3"
            android:indeterminate="true"
            app:indicatorColor="@color/sgula_primary"
            app:trackColor="@color/sgula_primary_soft" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/journal_state_card"
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/journal_state_title"
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="No entries yet" />

                <TextView
                    android:id="@+id/journal_state_body"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    tools:text="Your first reflection will appear here once you save it." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/journal_state_action"
                    style="@style/Widget.Sgula.Button.Secondary.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    tools:text="Try again" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/journal_entries_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/journal_back_to_editor"
            style="@style/Widget.Sgula.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:text="Back to editor" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
