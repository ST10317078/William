<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sgula_space_5"
        android:paddingEnd="@dimen/sgula_space_5"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Sgula.Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood check-in" />

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood log" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A quick check-in on how today is going. Each one earns +5 points." />

        <TextView
            style="@style/Widget.Sgula.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:text="How are you feeling?" />

        <!-- no card around the scale, the extra padding squeezed the labels onto two lines -->
        <com.example.insy7315_wil_.ui.widget.SgulaMoodScaleView
            android:id="@+id/mood_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3" />

        <com.example.insy7315_wil_.ui.widget.SgulaTextFieldView
            android:id="@+id/mood_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            app:sgulaLabel="Note"
            app:sgulaOptional="true"
            app:sgulaSingleLine="false"
            app:sgulaFieldMinHeight="@dimen/sgula_text_area_min_height"
            app:sgulaPlaceholder="What's behind this mood today?"
            app:sgulaHelperText="Add a trigger, a win, or anything you want to remember later." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_history_button"
                style="@style/Widget.Sgula.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="History" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mood_save_button"
                style="@style/Widget.Sgula.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sgula_space_3"
                android:layout_weight="1"
                android:text="Save mood" />
        </LinearLayout>

        <TextView
            android:id="@+id/mood_error_text"
            style="@style/Widget.Sgula.Text.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:textColor="@color/sgula_danger"
            android:visibility="gone"
            tools:text="We couldn't save your mood. Check your internet connection and try again."
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>