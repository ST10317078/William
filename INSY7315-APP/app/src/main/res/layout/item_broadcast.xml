<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sgula.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/broadcast_item_date"
                style="@style/Widget.Sgula.Text.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="4 August" />

            <TextView
                android:id="@+id/broadcast_item_duration"
                style="@style/Widget.Sgula.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="07:45" />
        </LinearLayout>

        <TextView
            android:id="@+id/broadcast_item_topic"
            style="@style/Widget.Sgula.Text.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            tools:text="Sleeping Through Worry" />

        <TextView
            android:id="@+id/broadcast_item_description"
            style="@style/Widget.Sgula.Text.CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_1"
            tools:text="Winding the body down when the mind will not." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>