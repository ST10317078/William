<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="@dimen/sgula_space_2"
    android:paddingBottom="@dimen/sgula_space_2"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/top_nav_label"
        style="@style/Widget.Sgula.Text.TopNavLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        tools:text="Home" />

    <View
        android:id="@+id/top_nav_underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sgula_nav_underline"
        android:layout_marginTop="@dimen/sgula_space_2"
        android:background="@drawable/sgula_top_nav_underline"
        android:duplicateParentState="true" />
</LinearLayout>
