<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/dropdown_label"
        style="@style/Widget.Sgula.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="How are you feeling?" />

    <LinearLayout
        android:id="@+id/dropdown_anchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sgula_space_2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/sgula_field_background"
        android:minHeight="@dimen/sgula_min_touch_target"
        android:paddingLeft="@dimen/sgula_field_h_padding"
        android:paddingRight="@dimen/sgula_field_h_padding"
        android:paddingTop="@dimen/sgula_field_v_padding"
        android:paddingBottom="@dimen/sgula_field_v_padding"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/dropdown_value"
            style="@style/Widget.Sgula.Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Calm" />

        <ImageView
            android:id="@+id/dropdown_chevron"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="@dimen/sgula_space_2"
            android:src="@drawable/ic_chevron_down"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:id="@+id/dropdown_error"
        style="@style/Widget.Sgula.Text.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sgula_space_2"
        android:textAppearance="@style/TextAppearance.Sgula.FieldError"
        android:visibility="gone"
        tools:text="Pick one to carry on."
        tools:visibility="visible" />
</merge>
