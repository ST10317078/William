<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/strength_bar_1"
            android:layout_width="24dp"
            android:layout_height="5dp"
            android:background="@drawable/sgula_strength_bar" />

        <View
            android:id="@+id/strength_bar_2"
            android:layout_width="24dp"
            android:layout_height="5dp"
            android:layout_marginStart="@dimen/sgula_space_1"
            android:background="@drawable/sgula_strength_bar" />

        <View
            android:id="@+id/strength_bar_3"
            android:layout_width="24dp"
            android:layout_height="5dp"
            android:layout_marginStart="@dimen/sgula_space_1"
            android:background="@drawable/sgula_strength_bar" />
    </LinearLayout>

    <TextView
        android:id="@+id/strength_label"
        style="@style/Widget.Sgula.Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sgula_space_2"
        tools:text="Medium strength" />
</merge>
