<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin manage accounts" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review client access, keep active accounts visible, and deactivate when needed." />

        <TextView
            style="@style/Widget.Sgula.Text.SectionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active clients can be deactivated from this view." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card.Table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.Sgula.AdminTable.Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Client" />

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Status" />

                    <TextView
                        style="@style/Widget.Sgula.Text.TableHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="Action" />
                </LinearLayout>

                <View style="@style/Widget.Sgula.AdminTable.Divider" />

                <LinearLayout
                    style="@style/Widget.Sgula.AdminTable.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.Sgula.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Jane Doe" />

                    <TextView
                        style="@style/Widget.Sgula.StatusBadge.Active"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Active" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Sgula.Button.Destructive.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deactivate" />
                </LinearLayout>

                <View style="@style/Widget.Sgula.AdminTable.Divider" />

                <LinearLayout
                    style="@style/Widget.Sgula.AdminTable.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.Sgula.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Sam Rivera" />

                    <TextView
                        style="@style/Widget.Sgula.StatusBadge.Active"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Active" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Sgula.Button.Destructive.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deactivate" />
                </LinearLayout>

                <View style="@style/Widget.Sgula.AdminTable.Divider" />

                <LinearLayout
                    style="@style/Widget.Sgula.AdminTable.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.Sgula.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Aisha Mokoena" />

                    <TextView
                        style="@style/Widget.Sgula.StatusBadge.Deactivated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Deactivated" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Sgula.Button.Secondary.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Inactive" />
                </LinearLayout>

                <View style="@style/Widget.Sgula.AdminTable.Divider" />

                <LinearLayout
                    style="@style/Widget.Sgula.AdminTable.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Widget.Sgula.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Liam Naidoo" />

                    <TextView
                        style="@style/Widget.Sgula.StatusBadge.Deactivated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Deactivated" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Sgula.Button.Secondary.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Inactive" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
