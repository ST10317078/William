<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/launchFragment">

    <fragment
        android:id="@+id/launchFragment"
        android:name="com.example.insy7315_wil_.ui.screens.auth.LaunchFragment"
        tools:layout="@layout/fragment_launch">
        <action
            android:id="@+id/action_launchFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_launchFragment_to_guestLandingFragment"
            app:destination="@id/guestLandingFragment" />
        <action
            android:id="@+id/action_launchFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/launchFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.insy7315_wil_.ui.screens.auth.LoginFragment"
        tools:layout="@layout/fragment_login">
        <!-- popUpTo clears launch, so back from home exits instead of returning to login -->
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/launchFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_passwordResetFragment"
            app:destination="@id/passwordResetFragment" />
        <action
            android:id="@+id/action_loginFragment_to_guestLandingFragment"
            app:destination="@id/guestLandingFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.insy7315_wil_.ui.screens.auth.RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/launchFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/passwordResetFragment"
        android:name="com.example.insy7315_wil_.ui.screens.auth.PasswordResetFragment"
        tools:layout="@layout/fragment_password_reset">
        <action
            android:id="@+id/action_passwordResetFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/guestLandingFragment"
        android:name="com.example.insy7315_wil_.ui.screens.auth.GuestLandingFragment"
        tools:layout="@layout/fragment_guest_landing">
        <action
            android:id="@+id/action_guestLandingFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_guestLandingFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/launchFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_guestLandingFragment_to_audioLibraryFragment"
            app:destination="@id/audioLibraryFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.insy7315_wil_.ui.screens.home.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_succulentFragment"
            app:destination="@id/succulentFragment" />
        <action
            android:id="@+id/action_homeFragment_to_moodLogFragment"
            app:destination="@id/moodLogFragment" />
        <action
            android:id="@+id/action_homeFragment_to_journalEditorFragment"
            app:destination="@id/journalEditorFragment" />
        <action
            android:id="@+id/action_homeFragment_to_audioLibraryFragment"
            app:destination="@id/audioLibraryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_broadcastFragment"
            app:destination="@id/broadcastFragment" />
        <action
            android:id="@+id/action_homeFragment_to_quizStartFragment"
            app:destination="@id/quizStartFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/succulentFragment"
        android:name="com.example.insy7315_wil_.ui.screens.home.SucculentFragment"
        tools:layout="@layout/fragment_succulent" />

    <fragment
        android:id="@+id/moodLogFragment"
        android:name="com.example.insy7315_wil_.ui.screens.mood.MoodLogFragment"
        tools:layout="@layout/fragment_mood_log">
        <action
            android:id="@+id/action_moodLogFragment_to_moodHistoryFragment"
            app:destination="@id/moodHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/moodHistoryFragment"
        android:name="com.example.insy7315_wil_.ui.screens.mood.MoodHistoryFragment"
        tools:layout="@layout/fragment_mood_history">
        <action
            android:id="@+id/action_moodHistoryFragment_to_moodLogFragment"
            app:destination="@id/moodLogFragment" />
    </fragment>

    <fragment
        android:id="@+id/journalEditorFragment"
        android:name="com.example.insy7315_wil_.ui.screens.journal.JournalEditorFragment"
        tools:layout="@layout/fragment_journal_editor">
        <action
            android:id="@+id/action_journalEditorFragment_to_journalHistoryFragment"
            app:destination="@id/journalHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/journalHistoryFragment"
        android:name="com.example.insy7315_wil_.ui.screens.journal.JournalHistoryFragment"
        tools:layout="@layout/fragment_journal_history">
        <action
            android:id="@+id/action_journalHistoryFragment_to_journalEditorFragment"
            app:destination="@id/journalEditorFragment" />
    </fragment>

    <fragment
        android:id="@+id/audioLibraryFragment"
        android:name="com.example.insy7315_wil_.ui.screens.audio.AudioLibraryFragment"
        tools:layout="@layout/fragment_audio_library">
        <action
            android:id="@+id/action_audioLibraryFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.insy7315_wil_.ui.screens.audio.PlayerFragment"
        tools:layout="@layout/fragment_player" />

    <fragment
        android:id="@+id/broadcastFragment"
        android:name="com.example.insy7315_wil_.ui.screens.audio.BroadcastFragment"
        tools:layout="@layout/fragment_broadcast">
        <action
            android:id="@+id/action_broadcastFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
        <action
            android:id="@+id/action_broadcastFragment_to_broadcastHistoryFragment"
            app:destination="@id/broadcastHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/broadcastHistoryFragment"
        android:name="com.example.insy7315_wil_.ui.screens.audio.BroadcastHistoryFragment"
        tools:layout="@layout/fragment_broadcast_history">
        <action
            android:id="@+id/action_broadcastHistoryFragment_to_broadcastFragment"
            app:destination="@id/broadcastFragment" />
        <action
            android:id="@+id/action_broadcastHistoryFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizStartFragment"
        android:name="com.example.insy7315_wil_.ui.screens.quiz.QuizStartFragment"
        tools:layout="@layout/fragment_quiz_start">
        <action
            android:id="@+id/action_quizStartFragment_to_quizQuestionFragment"
            app:destination="@id/quizQuestionFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizQuestionFragment"
        android:name="com.example.insy7315_wil_.ui.screens.quiz.QuizQuestionFragment"
        tools:layout="@layout/fragment_quiz_question">
        <action
            android:id="@+id/action_quizQuestionFragment_to_quizResultFragment"
            app:destination="@id/quizResultFragment"
            app:popUpTo="@id/quizStartFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/quizResultFragment"
        android:name="com.example.insy7315_wil_.ui.screens.quiz.QuizResultFragment"
        tools:layout="@layout/fragment_quiz_result">
        <action
            android:id="@+id/action_quizResultFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
        <action
            android:id="@+id/action_quizResultFragment_to_broadcastFragment"
            app:destination="@id/broadcastFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.insy7315_wil_.ui.screens.settings.SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_adminUploadFragment"
            app:destination="@id/adminUploadFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_adminAccountsFragment"
            app:destination="@id/adminAccountsFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_adminEngagementFragment"
            app:destination="@id/adminEngagementFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_galleryFragment"
            app:destination="@id/galleryFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_launchFragment"
            app:destination="@id/launchFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminUploadFragment"
        android:name="com.example.insy7315_wil_.ui.screens.admin.AdminUploadFragment"
        tools:layout="@layout/fragment_admin_upload" />

    <fragment
        android:id="@+id/adminAccountsFragment"
        android:name="com.example.insy7315_wil_.ui.screens.admin.AdminAccountsFragment"
        tools:layout="@layout/fragment_admin_accounts">
        <action
            android:id="@+id/action_adminAccountsFragment_to_adminEngagementFragment"
            app:destination="@id/adminEngagementFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminEngagementFragment"
        android:name="com.example.insy7315_wil_.ui.screens.admin.AdminEngagementFragment"
        tools:layout="@layout/fragment_admin_engagement" />

    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.example.insy7315_wil_.ui.gallery.GalleryFragment"
        tools:layout="@layout/fragment_gallery" />

</navigation>
