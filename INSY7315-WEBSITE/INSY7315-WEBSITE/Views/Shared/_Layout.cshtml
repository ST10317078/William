@inject Microsoft.Extensions.Options.IOptions<SiteOptions> SiteOptions
@{
    var site = SiteOptions.Value;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sgula is a calm space between your therapy sessions. Daily broadcasts, guided audio, mood check-ins and a private journal from Growth &amp; Development with @site.TherapistName." />
    <meta name="theme-color" content="#FBF8F2" />
    <title>@ViewData["Title"] · Sgula</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/quicksand.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_Icons")

    <header class="site-header">
        <div class="shell">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/plants/sprout.svg" alt="" />
                Sgula
            </a>
            <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <nav class="nav" id="site-nav">
                <a class="@(action == "Index" ? "active" : null)" asp-controller="Home" asp-action="Index">Home</a>
                <a href="@Url.Action("Index", "Home")#inside">Features</a>
                <a href="@Url.Action("Index", "Home")#privacy">Privacy</a>
                <a class="btn btn-primary" href="@site.PlayStoreUrl">Get the app</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell">
            <div>
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <img src="~/img/plants/sprout.svg" alt="" />
                    Sgula
                </a>
                <p>A calm space between your sessions. Growth &amp; Development with @site.TherapistName.</p>
            </div>
            <div class="footer-links">
                <a href="@Url.Action("Index", "Home")#inside">Features</a>
                <a href="@Url.Action("Index", "Home")#privacy">Privacy</a>
                <a href="mailto:@site.ContactEmail">Contact</a>
            </div>
            <p>&copy; <span data-year>2026</span> Sgula</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
