{
  "name": "sgula-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security rules tests for the Sgula Firestore database. Runs against the local emulator only.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-sgula-rules \"node --test --test-concurrency=1\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0"
  }
}
